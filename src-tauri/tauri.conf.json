{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scalengi Views",
  "version": "0.1.0-beta.1",
  "identifier": "com.scalengi.views",
  "build": {
    "beforeDevCommand": "pnpm desktop:web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm desktop:web:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scalengi Views",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Vues d'architecture d'entreprise",
    "longDescription": "Scalengi Views fournit des vues spécialisées et configurables pour analyser et piloter un système d'information.",
    "copyright": "Copyright © 2026 Corentin Petitdemange",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "French"
        ]
      }
    }
  }
}
