{
  "name": "Scalengi Views",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22.19.0",
      "pnpmVersion": "10.17.0"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "8gb"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Scalengi Views",
      "onAutoForward": "openBrowserOnce",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh && bash .devcontainer/start-demo.sh",
  "postStartCommand": "bash .devcontainer/start-demo.sh",
  "customizations": {
    "codespaces": {
      "openFiles": [".devcontainer/WELCOME.md"]
    },
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
