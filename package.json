{
  "name": "scalengi-view",
  "version": "1.2.1-alpha.6",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorentinPetitdemange/scalengi-views.git"
  },
  "bugs": {
    "url": "https://github.com/CorentinPetitdemange/scalengi-views/issues"
  },
  "homepage": "https://github.com/CorentinPetitdemange/scalengi-views#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "auth:dev": "cargo run --manifest-path server/Cargo.toml",
    "auth:check": "cargo check --manifest-path server/Cargo.toml",
    "auth:format:check": "cargo fmt --manifest-path server/Cargo.toml -- --check",
    "auth:lint": "cargo clippy --locked --manifest-path server/Cargo.toml --all-targets -- -D warnings",
    "auth:test": "cargo test --manifest-path server/Cargo.toml",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "desktop:web:dev": "vite --config desktop/vite.config.ts",
    "desktop:web:build": "vite build --config desktop/vite.config.ts",
    "module:build": "vite build --config module/vite.config.ts && vite build --config module/renderer.vite.config.ts && tsc -p tsconfig.renderer.json",
    "module:package": "pnpm module:build && node scripts/package-module.mjs",
    "desktop:check": "node scripts/check-desktop-version.mjs && pnpm desktop:web:build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "version:check": "node scripts/check-desktop-version.mjs",
    "version:set": "node scripts/set-version.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm build && pnpm module:build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-desktop --ignore-pattern dist-module --ignore-pattern src-tauri/target --ignore-pattern server/target --ignore-pattern .next"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reactflow": "11.11.4",
    "read-excel-file": "9.3.12",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "postcss": "8.5.26",
      "sharp": "0.35.4"
    }
  },
  "type": "module"
}
