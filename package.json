{
  "name": "scalengi-view",
  "version": "0.1.0-alpha.3",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorentinPetitdemange/scalengi-views.git"
  },
  "bugs": {
    "url": "https://github.com/CorentinPetitdemange/scalengi-views/issues"
  },
  "homepage": "https://github.com/CorentinPetitdemange/scalengi-views#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "desktop:web:dev": "vite --config desktop/vite.config.ts",
    "desktop:web:build": "vite build --config desktop/vite.config.ts",
    "desktop:check": "node scripts/check-desktop-version.mjs && pnpm desktop:web:build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "version:check": "node scripts/check-desktop-version.mjs",
    "version:set": "node scripts/set-version.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-desktop --ignore-pattern src-tauri/target --ignore-pattern .next"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reactflow": "11.11.4",
    "read-excel-file": "9.3.10",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module"
}
