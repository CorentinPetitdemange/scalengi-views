  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
