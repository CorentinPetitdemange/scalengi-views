# Installation profile. Keep "standard" for an empty production installation.
# Select "demo" only on the first startup of a disposable demonstration instance.
SCALENGI_INSTALLATION_PROFILE=standard

# Required on the first startup when SCALENGI_INSTALLATION_PROFILE=demo.
# Prefer SCALENGI_DEMO_ADMIN_PASSWORD_FILE outside Docker Compose so the secret
# is not exposed through the process environment.
SCALENGI_DEMO_ADMIN_EMAIL=
SCALENGI_DEMO_ADMIN_DISPLAY_NAME=Administrateur démo
SCALENGI_DEMO_ADMIN_PASSWORD=

# Authentication service defaults.
SCALENGI_AUTH_COOKIE_SECURE=false
SCALENGI_AUTH_SESSION_HOURS=8
