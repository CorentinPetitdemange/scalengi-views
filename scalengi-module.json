{
  "$schema": "./scalengi-module.schema.json",
  "schemaVersion": 1,
  "id": "com.scalengi.views",
  "name": "Scalengi Views",
  "version": "1.2.1-alpha.6",
  "kind": "feature",
  "description": "Créer des représentations spécialisées pour analyser, expliquer et piloter un système d’information.",
  "compatibility": {
    "platformApi": "1.x",
    "standalone": true
  },
  "distribution": {
    "provider": "github-release",
    "repository": "CorentinPetitdemange/scalengi-views",
    "assetPattern": "scalengi-views-module-v{version}.zip"
  },
  "entrypoints": {
    "module": "scalengi-views.mjs",
    "stylesheet": "scalengi-views.css",
    "renderer": "scalengi-views-renderer.mjs",
    "rendererStylesheet": "scalengi-views-renderer.css"
  },
  "exports": [
    "ScalengiViewsApp",
    "viewRegistry",
    "ViewRegistry",
    "ViewReport",
    "prepareViewReport"
  ],
  "capabilities": [
    "views.catalog",
    "views.installation-profiles",
    "views.instances.local",
    "views.import.excel",
    "views.export.image",
    "views.reports.controlled"
  ],
  "permissions": {
    "businessDataNetworkAccess": false,
    "localStorage": [
      "indexeddb",
      "preferences"
    ]
  }
}
